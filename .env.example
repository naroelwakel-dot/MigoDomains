# ============================================================
# Migo Domains - Environment template
# ------------------------------------------------------------
# الأسماء فقط. لا تضع أي قيمة حقيقية هنا مطلقًا.
# انسخ الملف إلى .env محليًا واملأه بنفسك. ملف .env مُتجاهَل في git.
# أي مفتاح يبدأ بـ SERVICE_ROLE أو SECRET يخص الـ backend فقط،
# وممنوع منعًا تامًا أن يظهر في أي ملفات من الواجهة الأمامية.
# ============================================================

# ---- Supabase ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- RDAP / availability ----
RDAP_USER_AGENT=
RDAP_TIMEOUT_MS=

# ---- Registrar provider (اختر: mock | namecheap | opensrs | cloudflare) ----
REGISTRAR_PROVIDER=mock
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_CLIENT_IP=
OPENSRS_USERNAME=
OPENSRS_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ---- FX (سعر الصرف) ----
FX_SOURCE_URL=
FX_API_KEY=

# ---- Admin / API ----
ADMIN_API_TOKEN=
